AllowedOrigins="https://*.electrical-contact-resistance.ru;http://localhost:8000"
CacheConfiguration__Uri="ecr-cache:6379"
CacheConfiguration__DefaultInMemoryExpirationMinutes=5
CacheConfiguration__DefaultSlidingExpirationMinutes=20
IdentitySettings__Uri="http://ecr-infrastructure-identity:5001/"
IdentitySettings__Audience="http://ecr-infrastructure-identity:5001/resources"
IdentitySettings__IssuerSigningKey="..."
IdentitySettings__ClockSkew=300
IdentitySettings__Scope="ECR.Web"
IdentitySettings__ValidIssuers__aux0="https://electrical-contact-resistance.ru/dev/auth/"
ConnectionStrings__UsersConnection="Data Source=ecr-databases-mssql,1433; database=ECR.Users; User Id=sa; Password=password123!; TrustServerCertificate=true"
ConnectionStrings__IdentityServer="Data Source=ecr-databases-mssql,1433; database=ECR.IdentityServer; User Id=sa; Password=password123!; TrustServerCertificate=true"
ConnectionStrings__RemoteConfig="mongodb://ecr-databases-mongo:27017?readPreference=primary&ssl=false"
ConnectionStrings__Economy="Server=ecr-databases-postgres;Port=5432;Database=economy;User Id=postgres;Password=12345678"
ConnectionStrings__Inventory="Server=ecr-databases-postgres;Port=5432;Database=inventory;User Id=postgres;Password=12345678"
ServicesConfiguration__Economy="http://ecr-economy-webapi:5004"
ServicesConfiguration__RemoteConfig="http://ecr-remoteconfig-webapi:5003"
