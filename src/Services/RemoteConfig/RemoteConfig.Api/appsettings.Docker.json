{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": {
    "ConnectionString": "mongodb://ecr-databases-mongo:27017?readPreference=primary&ssl=false",
    "DatabaseName": "ECR",
    "StagesCollection": "Stages",
    "HeroesCollections": "Heroes",
    "EnemiesCollection": "Enemies",
    "InventoryItemsCollection": "InventoryItems"
  },
  "IdentitySettings": {
    "Authority": "http://ecr-infrastructure-identity:5001/",
    "ValidAudiences": [
      "http://ecr-infrastructure-identity:5001/resources",
      "http://localhost"
    ],
    "ValidIssuers": [
      "http://ecr-infrastructure-identity:5001/",
      "http://localhost"
    ],
    "ClockSkew": 5,
    "IssuerSigningKey": null
  },
  "CacheUri": "http://cache:6379/"
}
